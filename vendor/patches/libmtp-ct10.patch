+static int
+ptp_prop_handle_cmp (const void *a, const void *b)
+{
+	uint32_t x = ((const MTPProperties *)a)->ObjectHandle, y = ((const MTPProperties *)b)->ObjectHandle;
+	return x < y ? -1 : x > y;
+}
+
+/*
+ * Loads the ObjectInfo and MTP proplist of every child of parent (0 = root)
+ * into the object cache with one GetObjPropList per property, so
+ * ptp_object_want() needn't send a request or two per object (~8 ms each on
+ * Android). Asks for single properties because with "all properties" older
+ * Android replaces format 0 with the parent's own format and returns only
+ * subfolders. Tried even with DEVICE_FLAG_BROKEN_MTPGETOBJPROPLIST, which
+ * Android gets for that reason: objects that come back without a filename and
+ * format are left out, and those, or all of them if a request fails, load the
+ * slow way.
+ */
+uint16_t
+ptp_object_want_children (PTPParams *params, uint32_t parent)
+{
+	static const uint16_t wanted[] = { PTP_OPC_ObjectFileName, PTP_OPC_ObjectFormat,
+		PTP_OPC_ObjectSize, PTP_OPC_DateModified, PTP_OPC_StorageID, PTP_OPC_ParentObject };
+	MTPProperties	*props = NULL;
+	int		nrofprops = 0, i, j, k;
+	uint16_t	ret;
+
+	if (!ptp_operation_issupported(params, PTP_OC_MTP_GetObjPropList))
+		return PTP_RC_OperationNotSupported;
+	for (i = 0; i < (int)(sizeof(wanted)/sizeof(wanted[0])); i++) {
+		MTPProperties	*more = NULL, *all;
+		int		n = 0;
+
+		ret = ptp_mtp_getobjectproplist_generic (params, parent, 0, wanted[i], 0, 1, &more, &n);
+		if (ret == PTP_RC_OK && n > 0 && !(all = realloc (props, (nrofprops + n) * sizeof(MTPProperties)))) {
+			ptp_destroy_object_prop_list (more, n);
+			ret = PTP_RC_GeneralError;
+		}
+		if (ret != PTP_RC_OK) {
+			ptp_destroy_object_prop_list (props, nrofprops);
+			return ret;
+		}
+		if (n > 0) {
+			memcpy (all + nrofprops, more, n * sizeof(MTPProperties));
+			props = all;
+			nrofprops += n;
+		}
+		free (more);
+	}
+	qsort (props, nrofprops, sizeof(MTPProperties), ptp_prop_handle_cmp);
+	for (i = 0; i < nrofprops; i = j) {
+		uint32_t	handle = props[i].ObjectHandle;
+		PTPObject	*ob = NULL;
+		int		have = 0;
+
+		for (j = i; j < nrofprops && props[j].ObjectHandle == handle; j++)
+			;
+		/* Replace any cached copy, so the listing is fresh. */
+		ptp_remove_object_from_cache (params, handle);
+		if (ptp_object_find_or_insert (params, handle, &ob) != PTP_RC_OK ||
+		    !(ob->mtpprops = malloc ((j - i) * sizeof(MTPProperties)))) {
+			for (k = i; k < j; k++)
+				ptp_destroy_object_prop (&props[k]);
+			continue;
+		}
+		/* The strings move with the structs; free(props) below doesn't free them. */
+		memcpy (ob->mtpprops, &props[i], (j - i) * sizeof(MTPProperties));
+		ob->nrofmtpprops = j - i;
+		for (k = i; k < j; k++) {
+			switch (props[k].property) {
+			case PTP_OPC_StorageID:
+				ob->oi.StorageID = props[k].propval.u32;
+				break;
+			case PTP_OPC_ParentObject:
+				ob->oi.ParentObject = props[k].propval.u32;
+				break;
+			case PTP_OPC_ObjectFormat:
+				ob->oi.ObjectFormat = props[k].propval.u16;
+				have |= 1;
+				break;
+			case PTP_OPC_ObjectSize:
+				if (props[k].datatype == PTP_DTC_UINT64)
+					ob->oi.ObjectCompressedSize = props[k].propval.u64;
+				else if (props[k].datatype == PTP_DTC_UINT32)
+					ob->oi.ObjectCompressedSize = props[k].propval.u32;
+				break;
+			case PTP_OPC_ObjectFileName:
+				if (props[k].propval.str && !ob->oi.Filename) {
+					ob->oi.Filename = strdup (props[k].propval.str);
+					have |= 2;
+				}
+				break;
+			case PTP_OPC_DateModified:
+				ob->oi.ModificationDate = ptp_unpack_PTPTIME (props[k].propval.str);
+				break;
+			}
+		}
+		if (have != 3) {
+			ptp_remove_object_from_cache (params, handle);
+			continue;
+		}
+		ob->flags |= PTPOBJECT_OBJECTINFO_LOADED | PTPOBJECT_STORAGEID_LOADED |
+			     PTPOBJECT_PARENTOBJECT_LOADED | PTPOBJECT_MTPPROPLIST_LOADED;
+	}
+	free (props);
 	return PTP_RC_OK;
 }
 
