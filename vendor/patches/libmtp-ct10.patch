+	if (ret == PTP_ERROR_CANCEL) {
+		/*
+		 * Cancel here rather than in ptp_transaction_new() so we can wait
+		 * for the device to settle. Without this the next command is taken
+		 * as object data and gets no response (~60s stall).
+		 */
+		PTP_USB *ptp_usb = (PTP_USB *) params->data;
+		int zlp;
+		params->cancelreq_func(params, ptp->Transaction_ID);
+		while (params->devstatreq_func(params) == PTP_RC_DeviceBusy)
+			usleep(200000);
+		/*
+		 * Android's f_mtp still has a bulk-out read queued for the object
+		 * data and only notices the cancel once it completes, so it would
+		 * swallow our next command. A zero-length packet completes it.
+		 */
+		libusb_bulk_transfer(ptp_usb->handle, ptp_usb->outep, NULL, 0, &zlp, 1000);
+	}
 	if (ret != PTP_RC_OK && ret != PTP_ERROR_CANCEL)
 		ret = PTP_ERROR_IO;
