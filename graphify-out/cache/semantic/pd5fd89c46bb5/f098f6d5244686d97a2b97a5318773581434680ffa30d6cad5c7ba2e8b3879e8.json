{"nodes": [{"id": "claude_patchcord_app", "label": "Patchcord (macOS MTP app)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_libmtp_ct10_patch", "label": "libmtp-ct10.patch", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Essential: stock libmtp USB-resets Android devices and mishandles cancel, wedging the CT10 and Redmi A5."}, {"id": "claude_no_usb_reset_flag", "label": "DEVICE_FLAG_NO_USB_RESET (0x1000)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One libusb_reset_device leaves the CT10 failing every OpenSession until replugged."}, {"id": "claude_no_reset_on_close", "label": "No USB reset on close for Android", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FORCE_RESET_ON_CLOSE removed from DEVICE_FLAGS_ANDROID_BUGS; reset dropped Redmi A5 out of File transfer mode."}, {"id": "claude_upload_cancel_fix", "label": "Upload cancel fix (1 s wait + ZLP)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it Android f_mtp swallows the next command as object data (60 s stall); GET_DEVICE_STATUS polling wedged the Redmi A5."}, {"id": "claude_download_cancel_fix", "label": "Download cancel fix (no GET_DEVICE_STATUS poll)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_fast_listing", "label": "Fast listing via GetObjPropList (ptp_object_want_children)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six single-property requests per folder: 920-file folder 7.3 s -> 0.39 s; single properties because 'all properties' breaks on CT10's older Android stack."}, {"id": "claude_ptpcamerad_takeover", "label": "ptpcamerad interface takeover", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Class-6 phones (Redmi A5) get claimed by ptpcamerad; DeviceManager.open SIGKILLs it and reopens."}, {"id": "claude_usb_exclusive_owner", "label": "UsbExclusiveOwner busy-device detection", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_devicemanager", "label": "DeviceManager (device layer)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_transfers", "label": "Transfers (batches, two bars, cancel undo)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_mtp_serial_queue", "label": "Serial mtp queue threading model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_lgpl_dynamic_linking", "label": "LGPL dynamic linking of libmtp/libusb", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both libraries are LGPL; dylibs in Contents/Frameworks keep the app compliant. Never link statically."}, {"id": "claude_release_process", "label": "Release process (make-dmg.sh, site/downloads, Vercel)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_activo_ct10", "label": "Activo CT10 DAP", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_redmi_a5", "label": "Redmi A5 (Unisoc, 2717:ff48)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_swiftui_review", "label": "SwiftUI review findings (not yet applied)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_libmtp_ct10_patch", "target": "claude_no_usb_reset_flag", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_libmtp_ct10_patch", "target": "claude_no_reset_on_close", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_libmtp_ct10_patch", "target": "claude_upload_cancel_fix", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_libmtp_ct10_patch", "target": "claude_download_cancel_fix", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_libmtp_ct10_patch", "target": "claude_fast_listing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 